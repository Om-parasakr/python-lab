<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="num =ve or-ve"/>
        <attribute name="authors" value="statlab"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-07-29 11:06:04 PM"/>
        <attribute name="created" value="c3RhdGxhYjtNODRXVzNQMjQ7MjAyNi0wNy0yOTsxMDo1MDo0OSBQTTsyNjMw"/>
        <attribute name="edited" value="c3RhdGxhYjtNODRXVzNQMjQ7MjAyNi0wNy0yOTsxMTowNjowNCBQTTsxOzI3MzE="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="num" type="Real" array="False" size=""/>
            <input variable="num"/>
            <if expression="num&gt;0">
                <then>
                    <output expression="positive" newline="True"/>
                </then>
                <else>
                    <if expression="num&lt;0">
                        <then>
                            <output expression="negative" newline="True"/>
                        </then>
                        <else>
                            <output expression="zero" newline="True"/>
                        </else>
                    </if>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
